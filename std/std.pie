
space std {
    print    = __builtin_print   ;
    type     = __builtin_type    ;
    decltype = __builtin_decltype;
    reset    = __builtin_reset   ;
    eval     = __builtin_eval    ;

    infix + = (a: String, b: String) => __builtin_concat(a, b);
    infix + = (a, b) => __builtin_add(a, b);
    infix * = (a, b) => __builtin_mul(a, b);
    infix - = (a, b) => __builtin_sub(a, b);
    infix / = (a, b) => __builtin_div(a, b);
    infix % = (a, b) => __builtin_mod(a, b);



    prefix(!) -   = (x) => __builtin_neg(x);
    prefix(!) not = (x) => __builtin_not(x);

    infix(&&) and = (x, y) => __builtin_and(x, y);
    infix(||) or  = (x, y) => __builtin_or (x, y);

    infix == = (a, b) => __builtin_eq(a, b);
    infix != = (a, b) => __builtin_not(__builtin_eq(a, b));
    infix <  = (a, b) => __builtin_lt(a, b);
    infix <= = (a, b) => __builtin_leq(a, b);
    infix >  = (a, b) => __builtin_gt(a, b);
    infix >= = (a, b) => __builtin_geq(a, b);



    mixfix([]) : [ : ] = (cont, at) => __builtin_get(cont, at);



    Enumerate = class {
        collection = {};
        index = 0;

        hasNext = () => __builtin_lt(index, __builtin_len(collection));
        next = () => {
            ind = index;
            index = __builtin_add(index, 1);
            {ind, __builtin_get(collection, ind)};
        };
    };


    __Iota = class {
        limit = 0;
        index = 0;
        step  = 1;

        hasNext = () => __builtin_lt(index, limit);
        next = () => {
            ind = index;
            index = __builtin_add(index, step);
            ind;
        };
    };

    .: Factory Function..
    .: probably means I need some form of constructors :)
    Iota = (args: ...) => {
        __builtin_conditional(
            __builtin_gt(__builtin_len(args), 3),
            __builtin_panic("Can't pass more than 3 arguments to std::Iota"),
            {
                match __builtin_len(args) {
                    = 3 => {
                        {begin, limit, step} = args;
                        __Iota(limit, begin, step);
                    };
                    _ => {
                        {first, ...rest} = args;
                        __Iota(rest..., first);
                    };
                };
            }
        );
    };



    Some = class { data = 0; };
    None = "Some Sentinal Value";

    Result = union { Some; None; };
};

